/* Rules */
"基本规则" = "Basics";
"主牌体系" = "Trump Cards";
"出牌" = "Playing Cards";
"计分" = "Scoring";
"升级" = "Ranking Up";
"完成" = "Done";
"rules.basic.body" = "• Four players: North–South vs East–West\n• Two full decks (108 cards), including jokers\n• The dealer team owns the current level, advancing from 2 to A";
"rules.trump.body" = "• The dealer team declares the trump suit\n• Trump order: Big Joker > Small Joker > level card in the trump suit > level cards in other suits > other cards in the trump suit\n• Every level card is trump, regardless of suit";
"rules.play.body" = "• The leader may play a single, pair, or tractor (consecutive pairs)\n• Followers must follow suit and may discard from another suit only when short\n• Side-suit cards cannot beat trump; trump can beat any side-suit card";
"rules.scoring.body" = "• 5 is worth 5 points; 10 and K are worth 10 points\n• The attacking team wins the round with 80 or more points\n• The final-trick winner takes the kitty points with a multiplier";
"rules.level.body" = "• If the dealer team wins, it advances 1–3 levels based on the attackers’ score\n• If the attacking team wins, it becomes the next dealer team\n• 120 points advances 1 level; 160 points advances 2\n• Reaching A starts the A round; win with an advance while already on A to win the game";

